{
  "name": "tool-test-proposal-review-app",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22 <25"
  },
  "scripts": {
    "dev": "node --env-file-if-exists=.env.local src/server.js --dev",
    "start": "node --env-file-if-exists=.env.local src/server.js",
    "build": "node scripts/build.js",
    "lint": "eslint .",
    "test": "node --test tests/*.test.js",
    "test:ui": "npm run build && playwright test",
    "sheets:check": "node --env-file-if-exists=.env.local scripts/check-sheets.js"
  },
  "dependencies": {
    "google-auth-library": "^11.3.1",
    "pdfkit": "^0.20.2",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.64.1",
    "@vitejs/plugin-react": "^6.1.2",
    "eslint": "^10.13.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.7",
    "globals": "^17.13.0",
    "vite": "^8.3.5"
  }
}
