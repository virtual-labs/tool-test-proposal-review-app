# Use a TEST copy of the existing spreadsheet during migration.
APP_ORIGIN=http://127.0.0.1:3000
GOOGLE_SPREADSHEET_ID=
GOOGLE_CLIENT_EMAIL=
# Paste the service-account private key with literal \n separators. Never commit it.
GOOGLE_PRIVATE_KEY=
# HTTPS Redis REST endpoint supporting Redis commands and EVAL (e.g. Upstash).
REDIS_REST_URL=
REDIS_REST_TOKEN=
# Required for email OTP. Generate a random secret with the command in README.
OTP_SECRET=
# Email-only Apps Script web app, deployed to execute as its authorized owner.
MAIL_RELAY_URL=
# Must match MAIL_RELAY_SECRET in the relay's Script Properties; distinct from OTP_SECRET.
MAIL_RELAY_SECRET=
PORT=3000
